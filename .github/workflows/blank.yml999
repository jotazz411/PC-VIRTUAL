name: 🎮 Gamer Virtual PC

on:
  workflow_dispatch:

jobs:
  virtual-pc:
    name: 🖥️ Gamer Virtual Environment
    runs-on: ubuntu-24.04

    timeout-minutes: 360

    steps:
      # ============================================================
      # 1. SISTEMA
      # ============================================================
      - name: 🔄 Atualizar sistema
        run: |
          sudo apt-get update
          sudo apt-get upgrade -y

      # ============================================================
      # 2. DESKTOP XFCE
      # ============================================================
      - name: 🖥️ Instalar ambiente gráfico
        run: |
          sudo DEBIAN_FRONTEND=noninteractive apt-get install -y \
            xfce4 \
            xfce4-goodies \
            dbus-x11 \
            x11-xserver-utils \
            xterm

      # ============================================================
      # 3. FERRAMENTAS DO SISTEMA
      # ============================================================
      - name: 🧰 Ferramentas essenciais
        run: |
          sudo apt-get install -y \
            git \
            curl \
            wget \
            unzip \
            zip \
            p7zip-full \
            tar \
            gzip \
            bzip2 \
            nano \
            vim \
            htop \
            tree \
            neofetch \
            jq \
            rsync \
            screen \
            tmux \
            build-essential \
            cmake \
            make \
            pkg-config

      # ============================================================
      # 4. ÁUDIO / VÍDEO / MULTIMÍDIA
      # ============================================================
      - name: 🎵 Multimídia
        run: |
          sudo apt-get install -y \
            ffmpeg \
            pulseaudio \
            alsa-utils \
            mesa-utils

      # ============================================================
      # 5. OPENGL / VULKAN
      # ============================================================
      - name: 🎮 Vulkan e gráficos
        run: |
          sudo apt-get install -y \
            mesa-vulkan-drivers \
            vulkan-tools \
            libvulkan1 \
            libgl1-mesa-dri \
            libglx-mesa0 \
            mesa-utils

          echo "=== OPENGL ==="
          glxinfo -B || true

          echo "=== VULKAN ==="
          vulkaninfo --summary || true

      # ============================================================
      # 6. WINE
      # ============================================================
      - name: 🍷 Instalar Wine
        run: |
          sudo dpkg --add-architecture i386
          sudo apt-get update

          sudo apt-get install -y \
            wine64 \
            wine32 \
            winbind \
            cabextract

          wine --version || true

      # ============================================================
      # 7. PYTHON
      # ============================================================
      - name: 🐍 Python
        run: |
          sudo apt-get install -y \
            python3 \
            python3-pip \
            python3-venv \
            python3-dev

          python3 --version
          pip3 --version

      # ============================================================
      # 8. NODE.JS
      # ============================================================
      - name: 🟢 Node.js
        run: |
          curl -fsSL https://deb.nodesource.com/setup_22.x | sudo -E bash -
          sudo apt-get install -y nodejs

          node --version
          npm --version

      # ============================================================
      # 9. JAVASCRIPT / DESENVOLVIMENTO
      # ============================================================
      - name: 💻 Ferramentas de programação
        run: |
          sudo apt-get install -y \
            default-jdk \
            golang \
            rustc \
            cargo

      # ============================================================
      # 10. NAVEGADOR
      # ============================================================
      - name: 🌐 Instalar navegador
        run: |
          sudo apt-get install -y firefox

      # ============================================================
      # 11. DIRETÓRIOS DO AMBIENTE
      # ============================================================
      - name: 📁 Criar estrutura
        run: |
          mkdir -p "$HOME/Desktop"
          mkdir -p "$HOME/Games"
          mkdir -p "$HOME/Projects"
          mkdir -p "$HOME/Downloads"
          mkdir -p "$HOME/Documents"
          mkdir -p "$HOME/.config"

      # ============================================================
      # 12. INFORMAÇÕES DO HARDWARE
      # ============================================================
      - name: 📊 Informações do PC
        run: |
          echo "======================================"
          echo "        🎮 VIRTUAL GAMER PC"
          echo "======================================"

          echo ""
          echo "🧠 CPU:"
          lscpu | grep -E \
            "Model name|CPU\(s\)|Thread|Core"

          echo ""
          echo "💾 RAM:"
          free -h

          echo ""
          echo "💿 DISCO:"
          df -h

          echo ""
          echo "🎮 GPU:"
          lspci | grep -Ei \
            "vga|3d|display" || true

          echo ""
          echo "🖥️ OpenGL:"
          glxinfo -B || true

          echo ""
          echo "🍷 Wine:"
          wine --version || true

          echo ""
          echo "🐍 Python:"
          python3 --version

          echo ""
          echo "🟢 Node:"
          node --version

          echo ""
          echo "🐧 Kernel:"
          uname -a

      # ============================================================
      # 13. CONFIGURAÇÃO XFCE
      # ============================================================
      - name: 🎨 Configurar desktop
        run: |
          mkdir -p "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml"

          cat > "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml" <<'EOF'
          <?xml version="1.0" encoding="UTF-8"?>

          <channel name="xsettings" version="1.0">
            <property name="Net" type="empty">
              <property name="ThemeName" type="string" value="Default"/>
              <property name="IconThemeName" type="string" value="hicolor"/>
            </property>
          </channel>
          EOF

      # ============================================================
      # 14. SCRIPT DE INICIALIZAÇÃO
      # ============================================================
      - name: ⚡ Criar launcher
        run: |
          cat > "$HOME/Desktop/system-info.sh" <<'EOF'
          #!/bin/bash

          clear

          echo "======================================"
          echo "        🎮 GAMER VIRTUAL PC"
          echo "======================================"

          echo
          echo "CPU:"
          lscpu | grep "Model name" | head -1

          echo
          echo "RAM:"
          free -h

          echo
          echo "DISCO:"
          df -h "$HOME" | tail -1

          echo
          echo "GPU:"
          lspci | grep -Ei "vga|3d|display" || true

          echo
          echo "======================================"
          EOF

          chmod +x "$HOME/Desktop/system-info.sh"

      # ============================================================
      # 15. TESTES
      # ============================================================
      - name: 🧪 Testar ambiente
        run: |
          echo "=== TESTE DO AMBIENTE ==="

          command -v git
          command -v python3
          command -v node
          command -v wine
          command -v ffmpeg
          command -v cmake

          echo ""
          echo "✅ Git OK"
          echo "✅ Python OK"
          echo "✅ Node.js OK"
          echo "✅ Wine OK"
          echo "✅ FFmpeg OK"
          echo "✅ CMake OK"
          echo "✅ Ambiente preparado"

      # ============================================================
      # 16. RESUMO FINAL
      # ============================================================
      - name: 🏁 Finalizar
        run: |
          echo ""
          echo "=============================================="
          echo "       🎮 VIRTUAL GAMER PC PRONTO"
          echo "=============================================="
          echo ""
          echo "🖥️ Desktop: XFCE"
          echo "🐧 Sistema: Ubuntu 24.04"
          echo "🎮 Vulkan/OpenGL: instalado"
          echo "🍷 Wine: instalado"
          echo "🐍 Python: instalado"
          echo "🟢 Node.js: instalado"
          echo "☕ Java: instalado"
          echo "🐹 Go: instalado"
          echo "🦀 Rust: instalado"
          echo "🎬 FFmpeg: instalado"
          echo ""
          echo "⚠️ O runner é temporário e será destruído"
          echo "   quando a execução do workflow terminar."
          echo ""
          echo "=============================================="
